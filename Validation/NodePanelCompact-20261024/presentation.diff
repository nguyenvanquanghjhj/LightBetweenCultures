+        Sprite DialoguePortrait(EventDefinition definition,bool lumiSpeaking,out bool useMesh)
+        {
+            useMesh=false;
+            if(lumiSpeaking||definition?.actor=="Lumi")return art.lumiPortrait;
+            if(definition==null)return null;
+            // Only actual actors belong above dialogue. A node category badge is
+            // navigation UI, never a substitute portrait for information/actions.
+            var skin=AdventureUIArt.Load();
+            if(definition.type=="encounter")
+            {
+                var enemy=skin.Enemy(definition.enemyId);
+                if(enemy==null||enemy.categoryIcon)return null;
+                useMesh=true;return enemy.portrait??enemy.sprite;
+            }
+            var npc=skin.Npc(definition.npcId);
+            if(npc!=null&&!npc.categoryIcon)
+            {useMesh=npc.portraitUseSpriteMesh;return npc.portrait??npc.sprite;}
+            return definition.legacyTutorial?art.maiPortrait:null;
+        }
