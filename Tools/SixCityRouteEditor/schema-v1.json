{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lbc:route-design:v1",
  "title": "LBC route design proposal v1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "sourceFingerprint",
    "coordinateSystem",
    "scope",
    "cities"
  ],
  "properties": {
    "format": {
      "const": "LBC_ROUTE_DESIGN"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceFingerprint": {
      "const": "5579a1546c45bc051ff9f58a75ddb05850d1f2371494ecf5f1c196070836dcaa"
    },
    "coordinateSystem": {
      "const": {
        "range": [
          0,
          1000
        ],
        "origin": "top-left",
        "x": "right",
        "y": "down",
        "unityConversion": "Unity.x=X/1000; Unity.y=1-Y/1000",
        "lengthMetric": "Image-proportional units: hypot(dx,dy*imageHeight/imageWidth), map width=1000"
      }
    },
    "scope": {
      "enum": [
        "all",
        "city"
      ]
    },
    "cities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/city"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "waypoints",
        "bidirectional",
        "travel",
        "sourceEdgeId",
        "sourceRouteKey",
        "constraints"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[-A-Za-z0-9_]{1,80}$"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "waypoints": {
          "type": "array",
          "maxItems": 3000,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "bidirectional": {
          "type": "boolean"
        },
        "travel": {
          "enum": [
            "walk",
            "ferry"
          ]
        },
        "sourceEdgeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRouteKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraints": {
          "type": "object"
        }
      }
    },
    "city": {
      "type": "object",
      "required": [
        "cityId",
        "status",
        "notes",
        "preservedCityData",
        "nodes",
        "edges",
        "draft"
      ],
      "properties": {
        "cityId": {
          "enum": [
            "hoi_an",
            "hue",
            "da_lat",
            "jeonju",
            "gyeongju",
            "seoul"
          ]
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "DRAFT",
            "READY_FOR_REVIEW"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        },
        "preservedCityData": {
          "type": "object"
        },
        "nodes": {
          "type": "array"
        },
        "edges": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "draft": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/edge"
            }
          ]
        }
      }
    }
  },
  "$comment": "model.js additionally enforces exact canonical node/arrival/city metadata and source-edge constraints; complete edges require a known non-null end; draft may be unfinished. This schema is shipped locally and never fetched by the application."
}
